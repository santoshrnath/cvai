# =============================================================================
# CV Intelligence Agent — environment template
# =============================================================================
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# `deploy/hetzner/deploy.sh` scp's your `.env.local` to the server as `.env`.
# =============================================================================

# ---- Anthropic (Claude) — required for all AI work -------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Database (Postgres with pgvector for fallback / candidate metadata) ---
# Local: postgresql://cvai:cvai@localhost:5432/cvai?schema=public
# Hetzner: postgresql://cvai:<pw>@10.0.0.5:5432/cvai?schema=public
DATABASE_URL=postgresql://cvai:cvai@localhost:5432/cvai?schema=public

# ---- Vector database -------------------------------------------------------
# Set to "qdrant" (production) or "pgvector" (fallback / dev-only).
VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=cv_chunks

# ---- Object storage --------------------------------------------------------
# "s3" → Hetzner Storage Box (S3-compatible) or any S3-compatible endpoint.
# "local" → ./storage-local (dev only).
STORAGE_PROVIDER=local

# Hetzner Storage Box / S3-compatible
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_CV_ORIGINALS=cv-originals
S3_BUCKET_CV_CHUNKS=cv-chunks
S3_FORCE_PATH_STYLE=true

# ---- Embeddings ------------------------------------------------------------
# "local"  → @xenova/transformers (no API key, downloads model on first run)
# "voyage" → Voyage AI (Anthropic's recommended embedding partner)
# "openai" → OpenAI text-embedding-3-small
#
# Note: Anthropic Claude does NOT expose an embedding model. Voyage AI is
# Anthropic's officially recommended embeddings provider.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-lite
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Upload limits ---------------------------------------------------------
MAX_UPLOAD_SIZE_MB=25

# ---- Deployment ------------------------------------------------------------
CVAI_PORT=3060
PUBLIC_HOSTNAME=cv.oneplaceplatform.com
TRAEFIK_NETWORK=coolify
